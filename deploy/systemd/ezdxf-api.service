[Unit]
Description=ezdxf image conversion and Cartesian targeting API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ezdxf-api
Group=ezdxf-api
WorkingDirectory=/var/lib/ezdxf-api
Environment=EZDXF_API_WORKSPACE=/var/lib/ezdxf-api
Environment=EZDXF_API_HOST=127.0.0.1
Environment=EZDXF_API_PORT=8766
Environment=EZDXF_CURSOR_BRIDGE_URL=http://127.0.0.1:3472
Environment=EZDXF_API_MAX_UPLOAD_MB=50
Environment=EZDXF_API_TOKEN_FILE=/etc/ezdxf-api/api-token
Environment=EZDXF_CURSOR_TOKEN_FILE=/etc/ezdxf-api/cursor-token
ExecStart=/opt/ezdxf-api/venv/bin/ezdxf-api
Restart=on-failure
RestartSec=3
TimeoutStartSec=30
TimeoutStopSec=15
UMask=0077

NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictNamespaces=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=127.0.0.0/8
IPAddressAllow=::1/128
ReadWritePaths=/var/lib/ezdxf-api
InaccessiblePaths=-/dev/sda -/dev/sda1 -/dev/sda2 -/dev/sda5
DevicePolicy=closed
ProtectProc=invisible
ProcSubset=pid
RemoveIPC=true
MemoryMax=4G
TasksMax=128

[Install]
WantedBy=multi-user.target
